{
  "name": "hydrus-pocket",
  "version": "1.4.3",
  "description": "Phone-first, tailnet-only companion for browsing and lightly organizing a Hydrus archive.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matvei77/hydrus-phone.git"
  },
  "bugs": {
    "url": "https://github.com/matvei77/hydrus-phone/issues"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c blue,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "check:release": "npm run check && npm run test:e2e && npm run check:licenses && npm audit --omit=dev"
  },
  "dependencies": {
    "@fastify/compress": "^8.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.3.0",
    "@tanstack/react-query": "^5.81.5",
    "@tanstack/react-virtual": "^3.13.12",
    "dotenv": "^17.2.0",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.53.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.34",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4"
  }
}
